{
  "name": "nuxt-complete-starter",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "npm run codegen && nuxt build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "codegen": "graphql-codegen --config codegen.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nuxt/fonts": "^0.14.0",
    "@preprio/toolkit": "^0.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "graphql": "^17.0.2",
    "nuxt": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.4",
    "@graphql-codegen/client-preset": "^6.2.1",
    "@graphql-codegen/introspection": "^6.1.0",
    "dotenv": "^18.0.5",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
